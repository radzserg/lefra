{
  "author": "Sergey Radzishevskii <radzserg@gmail.com>",
  "bin": {
    "lefra": "./dist/application/bin/lefra.js"
  },
  "dependencies": {
    "bignumber.js": "^9.1.2",
    "slonik": "^46.4.0",
    "slonik-interceptor-field-name-transformation": "^46.4.0",
    "yargs": "^17.7.2",
    "zod": "^3.24.1"
  },
  "description": "",
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "@types/yargs": "^17.0.33",
    "eslint": "^9.18.0",
    "eslint-config-canonical": "^44.3.39",
    "eslint-plugin-sql": "^3.2.1",
    "husky": "^9.1.7",
    "install": "^0.13.0",
    "lint-staged": "^15.4.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "keywords": [
    "ledger",
    "ledger framework",
    "ledger system",
    "bookkeeping",
    "accounting",
    "double-entry",
    "Double-Entry Ledger",
    "Financial Tracking",
    "Ledger Transactions",
    "Accounting System",
    "Currency Handling",
    "Financial Management",
    "Transaction Records",
    "Ledger Operations",
    "Financial Transactions"
  ],
  "lint-staged": {
    "src/**/*.ts": [
      "pnpm lint:format"
    ],
    "tests/**/*.ts": [
      "pnpm lint:format"
    ]
  },
  "license": "ISC",
  "homepage": "https://github.com/radzserg/lefra",
  "name": "lefra",
  "scripts": {
    "build": "tsc && tsc-alias",
    "lefra": "tsx ./src/application/bin/lefra.ts",
    "lint:eslint": "eslint .",
    "lint:format": "eslint --fix $FILES",
    "test": "vitest --no-coverage --no-watch",
    "prepare": "husky"
  },
  "files": [
    "README.md",
    "dist/**",
    "!dist/tests/**",
    "database/schema.sql"
  ],
  "exports": {
    ".": {
      "node": {
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "type": "module",
  "version": "1.0.1"
}
