{
  "author": "Sergey Radzishevskii <radzserg@gmail.com>",
  "bin": {
    "lefra": "./dist/application/bin/lefra.js"
  },
  "dependencies": {
    "bignumber.js": "^11.1.5",
    "slonik": "^49.10.7",
    "slonik-interceptor-field-name-transformation": "^49.10.7",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "description": "TypeScript double-entry ledger library for PostgreSQL (see also Ledfra, the hosted version — ledfra.com)",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.39.5",
    "eslint-config-canonical": "^47.4.2",
    "eslint-plugin-sql": "^3.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "ledger",
    "postgresql",
    "ledger framework",
    "ledger system",
    "bookkeeping",
    "accounting",
    "double-entry",
    "Double-Entry Ledger",
    "Financial Tracking",
    "Ledger Transactions",
    "Accounting System",
    "Currency Handling",
    "Financial Management",
    "Transaction Records",
    "Ledger Operations",
    "Financial Transactions"
  ],
  "lint-staged": {
    "src/**/*.ts": [
      "pnpm lint:format"
    ],
    "tests/**/*.ts": [
      "pnpm lint:format"
    ]
  },
  "license": "ISC",
  "homepage": "https://github.com/radzserg/lefra",
  "name": "lefra",
  "scripts": {
    "build": "tsc && tsc-alias",
    "lefra": "tsx ./src/application/bin/lefra.ts",
    "lint:eslint": "eslint .",
    "lint:format": "eslint --fix $FILES",
    "test": "vitest --no-coverage --no-watch",
    "prepare": "husky"
  },
  "files": [
    "README.md",
    "dist/**",
    "!dist/tests/**",
    "database/schema.sql"
  ],
  "exports": {
    ".": {
      "node": {
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radzserg/lefra.git"
  },
  "type": "module",
  "version": "1.0.2"
}
